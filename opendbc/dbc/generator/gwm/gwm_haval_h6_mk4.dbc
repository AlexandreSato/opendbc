CM_ SG_ 96 GAS_POSITION "0 - 100%";
CM_ SG_ 96 BRAKE_SIGNAL "1 = BRAKE PRESSED";
CM_ SG_ 96 ACC_GAS_POSITION "0 - 100% | WHEN ACC REMAINS INFORMATION";
CM_ SG_ 96 REQ_REVIEW_POWER_CONSUMPTION2 "REQ FACTOR CONVERTER";
CM_ SG_ 96 REQ_REVIEW_POWER_STATE_SIGNAL "1 = OFF | 12 WARM-UP | 5 = ON";
CM_ SG_ 96 REQ_REVIEW_POWER_STATE_SIGNAL2 "1 = OFF | 0 = ON";
CM_ SG_ 147 IMPRECISE_SPEED "lower precision, reverse is positive as well";
CM_ SG_ 147 REQ_REVIEW_SPEED "INITIALLY ADJUSTED TO KPH BUT ITS NOT";
CM_ SG_ 147 REQ_REVIEW_SPEED2 "INITIALLY ADJUSTED TO KPH BUT ITS NOT";
CM_ SG_ 161 STEERING_ANGLE "0 CENTER";
CM_ SG_ 161 STEERING_DIRECTION "1=right (CW), 0=left (CCW). Confirmed MK4: changes exactly at wheel center.";
CM_ SG_ 161 STEERING_RATE "Peak identified 3680, 0 = stopped";
CM_ SG_ 161 RATE_DIRECTION "Unconfirmed — current VAL_ labels make no sense. Needs re-analysis.";
CM_ SG_ 161 AP_REDUCE_DISTANCE_COMMAND "AUTOPILOT STALK";
CM_ SG_ 161 AP_CANCEL_COMMAND "1 when stalk pulled UP (D→N, D→R skip-N, or any→P lateral button). Confirmed MK4.";
CM_ SG_ 161 AP_ENABLE_COMMAND "1 when stalk pulled DOWN (R→D, N→D). Confirmed MK4. Also triggers ACC activation.";
CM_ SG_ 259 SPEED "PRECISE, KPH, DASHBOARD SPEED, BIT LOWER THAN GPS SPEED";
CM_ SG_ 288 REQ_REVIEW_MOVING "1 = CAR IS MOVING";
CM_ SG_ 288 REVIEW_REQ_BRAKE_SIGNAL2 "0 | 128 BRAKE PRESSED";
CM_ SG_ 299 CRC_COUNTER "byte8: CRC-8 (poly=0x1D, init=0xD1) over bytes 9-15 (constant payload + COUNTER_1).";
CM_ SG_ 299 CRC_STEER "byte16: CRC-8 (poly=0x1D, init=0x05) over bytes 17-23 (STEER_REQUEST + COUNTER_2). Recompute whenever STEER_REQUEST or COUNTER_2 changes.";
CM_ SG_ 299 STEER_REQUEST "14-bit angle command (factor=0.1, offset=-779.6). raw14=round((angle_deg+779.6)*10), zero-point raw14=7796. Offset is the EPS command-response transfer (raw->actual wheel), not the camera-signal zero: with -778.4 the wheel SETTLED 1.2deg RIGHT of command (d3 engaged, n=34766 median; OEM mirror corr slope 0.999). -779.6 lands the wheel on the commanded angle (kills a constant rightward steering bias). Earlier -777.7->-778.4 was a partial fix of the same offset.";
CM_ SG_ 299 EPS_LKAS_ANGLE_ENABLE "byte21: EPS activation flag. 0x3f = LKAS angle-control active (EPS executes STEER_REQUEST). 0x1f = passive (EPS ignores). Must be 0x3f when commanding. Verified vs 3000 OEM frames in route_55 seg34 (2834 active, 166 passive transitions).";
CM_ SG_ 299 EPS_LKAS_ANGLE_CFG "byte22: EPS angle-control config byte. 0xe5 = active (paired with EPS_LKAS_ANGLE_ENABLE=0x3f). 0x81 = passive. Hardcode to 0xe5 when commanding angle.";
CM_ SG_ 311 REQ_REVIEW_DRIVE_MODE "1 = P | 0 = D";
CM_ SG_ 311 BRAKE_SIGNAL1 "0 = NO | 1 = BRAKE PRESSED";
CM_ SG_ 311 BRAKE_SIGNAL2 "0 NO | 1 = BRAKE PRESSED";
CM_ SG_ 311 BRAKE_PRESSURE "MAX PRESSURE IDENTIFIED = 4184 | 0 = NO PRESSURE";
CM_ SG_ 315 FRONT_LEFT_WHEEL_SPEED "Based on the car's dashboard speed";
CM_ SG_ 315 FRONT_RIGHT_WHEEL_SPEED "Based on the car's dashboard speed";
CM_ SG_ 315 FRONT_DISTANCE_ACCUMULATOR "?? doubts";
CM_ SG_ 315 REAR_LEFT_WHEEL_SPEED "Based on the car's dashboard speed";
CM_ SG_ 315 REAR_RIGHT_WHEEL_SPEED "Based on the car's dashboard speed";
CM_ SG_ 315 REAR_DISTANCE_ACCUMULATOR "PULSES";
CM_ SG_ 323 BRAKE_GAS_STATE_2 "Redundant copy of the powertrain brake-vs-gas state (was BYPASSME_1, the ACC_CMD 87|18 instance). 131068(0x1FFFC)=brake, 131070(0x1FFFE)=gas (bit1). Set consistently with BRAKE_GAS_STATE so regen activates while braking.";
CM_ SG_ 323 SPEED_REAL "PRECISE, EQUAL GPS SPEED";
CM_ SG_ 323 BRAKE_GAS_STATE "Powertrain brake-vs-gas STATE (was BYPASS_ACC2). 0=brake, 0x80000(524288)=gas. The HEV ECU keys REGENERATION off this (and the redundant BRAKE_GAS_STATE_2), NOT off BRAKE_OR_GAS_REQ. openpilot must set 0 when braking (REQ=13) or regen never activates. Regen MAGNITUDE (msg 283 byte22) stays the powertrain's call from the driver's Low/Normal/Heavy setting + brake demand. Verified OEM dd 2026-06-26.";
CM_ SG_ 412 LEFT_TURN_SIGNAL "ON/OFF ACCORDINGLY LIGHT";
CM_ SG_ 545 DRIVE_MODE_GEAR_CMD "Commanded/selected gear (full byte). 0=P, 5=D, 6=N, 7=R. Bit2 overlaps with DRIVE_MODE_GEAR_ENABLED.";
CM_ SG_ 545 DRIVE_MODE_GEAR_ENABLED "1 when any non-P gear is engaged (byte6 bit2). Mirrors DRIVE_MODE_GEAR_CMD != 0.";
CM_ SG_ 545 DRIVE_MODE_GEAR_REAL "Actual engaged gear. 0=P, 1=D, 2=N, 3=R. Use this for gear detection — supersedes GEAR_STATE_BYTE workaround.";
CM_ BO_ 573 "HAVE LATERAL STATE INFO";
CM_ SG_ 581 _CHECKSUM "crc8(bytes[1:8], poly=0x1D, init=0x4F)";
CM_ SG_ 581 EPS_ANGLE_CMD "EPS echo of commanded angle. Fit angle=0.032*raw-91.09 (RMSE 3.2deg). This is the angle the EPS received from STEER_CMD and reflects back — NOT torque. byte1 (0x51-0x55, slow-changing) and byte6 (full range, data) are unidentified signals in this message.";
CM_ SG_ 581 EPS_ANGLE "EPS steering-angle readback (diagnostic only, NOT used by carstate). Fit angle=0.041922*raw-364.81 (offset re-anchored 2026-06-24 to STEERING_ANGLE: prior -363.92 read ~0.9deg high near center, d3 |ang|<15). Noisy on MK4 (~0.77deg RMSE) and lags STEERING_ANGLE by 0.081s (20Hz msg).";
CM_ SG_ 683 CAR_DISTANCE_SELECTION "Follow-distance dash selected by driver. MK4 PHEV has FOUR dashes 1/2/3/4 (closest..farthest); 0 is a boot/uninit transient. Folded to openpilot's 3 personalities dash1->aggressive, 2->standard, 3->standard, 4->relaxed in gwm/interface.py.";
CM_ SG_ 714 LOCK_DOORS_BUTTON "1 = PRESSED";
CM_ SG_ 726 REGEN_LEVEL "Driver's regen-level selector (msg 726 byte45). Values 8=Normal, 16=Low, 24=Heavy. Decoded on drive ec by correlating with regen-on (msg283 b22) vs decel: measured entry-points Low~-0.5, Normal~-0.3, Heavy~0 m/s^2. Heavy is the strongest of the 3 but NOT full one-pedal (separate one-pedal config, not enabled). Used by carcontroller to set the regen brake-state entry threshold per level.";
CM_ SG_ 793 REQ_REVIEW_CAR_STATE "1 = STOPPED | 0 = MOVING";
CM_ SG_ 837 DOOR_LOCK_STATE "0 = LOCKED / 1 = UNLOCKED";
CM_ SG_ 837 DOOR_LOCK_STATE2 "0 = LOCKED / 1 = UNLOCKED";
CM_ SG_ 849 SEAT_BELT_DRIVER_STATE "0 = Fastened / 1 = Released";
CM_ SG_ 849 SEAT_BELT_DRIVER_STATE2 "0 = Fastened / 1 = Released";
CM_ SG_ 199 GEAR_STALK_POSITION "Gear/AP stalk lever position (byte1). Momentary lever springs back to 0x0f=rest. Decoded on drive fa (all-bus sweep, can_data/fa_clean.py + fa_c7_pattern.py): 0x0f rest, 0x4b gentle DOWN, 0x5a FURTHER_DOWN (and P->D), 0x2d gentle UP, 0x3c FURTHER_UP. Redundant-complement bit encoding: DOWN=bit6(set)/bit2(clear), UP=bit5(set)/bit1(clear), FURTHER=bit4(set)/bit0(clear); bit3 always 1, bit7 always 0. This is the ONLY message that distinguishes gentle vs further and up vs down (msg 161 AP_ENABLE/CANCEL only fire on the FURTHER gestures). The lateral->PARK button does NOT appear here. MK4 PHEV.";
CM_ SG_ 199 STALK_DOWN "byte1 bit6: 1 on ANY downward lever motion (gentle DOWN 0x4b AND FURTHER_DOWN 0x5a, plus the P->D entry). MK4 engages openpilot on the rising edge of this (gated on gear already D + no fresh gear transition + vEgo>0.5).";
CM_ SG_ 199 STALK_UP "byte1 bit5: 1 on ANY upward lever motion (gentle UP 0x2d AND FURTHER_UP 0x3c).";
CM_ SG_ 199 STALK_FURTHER "byte1 bit4: 1 only on the hard-detent 'further/click' gestures (FURTHER_DOWN, FURTHER_UP, P->D). Combine with STALK_DOWN/STALK_UP to tell gentle from further (gentle = direction bit set AND STALK_FURTHER=0).";
CM_ SG_ 199 CRC "byte0: per-frame message checksum. Read-only signal (openpilot never transmits 0xC7); checksum algorithm not reverse-engineered.";
CM_ SG_ 199 COUNTER "byte7 low nibble: rolling 0-15 message counter.";
VAL_ 161 RATE_DIRECTION 1 "unknown_1" 2 "unknown_2" 3 "unknown_3";
